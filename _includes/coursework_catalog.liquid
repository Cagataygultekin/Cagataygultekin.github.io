<div class="coursework-catalog">
  {% for section in include.sections %}
    <section class="coursework-section">
      <div class="coursework-section-heading">
        <p class="coursework-section-kicker">Area 0{{ forloop.index }}</p>
        <h2>{{ section.name }}</h2>
        <p>{{ section.summary }}</p>
      </div>

      <div class="coursework-grid">
        {% for course in section.courses %}
          {% assign official_url = course.official_url %}
          {% unless official_url or course.external %}
            {% if include.institution == 'tum' and course.code %}
              {% assign code_prefix = course.code | slice: 0, 2 %}
              {% if code_prefix == 'IN' or code_prefix == 'CI' %}
                {% capture official_url %}https://academics.nat.tum.de/en/studies/org/mh/details/mod/{{ course.code }}{% endcapture %}
              {% endif %}
            {% elsif include.institution == 'metu' and course.code %}
              {% assign code_prefix = course.code | slice: 0, 3 %}
              {% if code_prefix == 'CNG' %}
                {% assign code_number = course.code | remove: 'CNG' %}
                {% capture official_url %}https://catalog.metu.edu.tr/course.php?course_code=3550{{ code_number }}&prog=355{% endcapture %}
              {% endif %}
            {% endif %}
          {% endunless %}

          <article
            class="course-card"
            {% if course.code %}
              id="{{ course.code | downcase }}"
            {% endif %}
          >
            <details class="course-card-disclosure">
              <summary>
                <span class="course-card-meta">
                  {% if course.code -%}
                    <span class="course-code">{{ course.code }}</span>
                  {%- endif %}
                  {% if course.status %}
                    <span class="course-credit">{{ course.status }}</span>
                  {% else %}
                    <span class="course-credit">{{ course.ects }} ECTS</span>
                  {% endif %}
                </span>
                <span class="course-title">{{ course.title }}</span>
                <span class="course-expand-control">
                  <span>Course content</span>
                  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </span>
              </summary>

              <div class="course-card-details">
                <p class="course-detail-label">Official course content, summarized</p>
                <p>{{ course.details | default: course.focus }}</p>
                {% unless course.external %}
                  <a href="{{ official_url | default: include.catalog_url }}" target="_blank" rel="noopener">
                    Official catalog source <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                {% endunless %}
              </div>
            </details>

            {% if course.tag or course.link or course.links %}
              <div class="course-card-footer">
                {% if course.tag -%}
                  <span class="course-tag">{{ course.tag }}</span>
                {%- endif %}
                {% if course.link or course.links %}
                  <div class="course-link-list">
                    {% if course.link %}
                      <a href="{{ course.link | relative_url }}">Project overview <i class="fa-solid fa-arrow-right"></i></a>
                    {% endif %}
                    {% for link in course.links %}
                      <a href="{{ link.url }}" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> {{ link.label }}</a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
