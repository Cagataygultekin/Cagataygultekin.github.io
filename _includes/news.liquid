<div class="news">
  {% assign current_lang = page.lang | default: site.lang %}
  {% assign translations = site.data.i18n[current_lang] %}
  {% if site.news != blank %}
    {% assign localized_news = site.news | where: 'lang', current_lang %}
    {% assign news_size = localized_news | size %}
    <div
      class="table-responsive"
      {% if include.compact and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = localized_news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            {% assign month_number = item.date | date: '%m' %}
            <th scope="row" style="width: 20%">{{ item.date | date: '%-d' }} {{ translations.months[month_number] }} {{ item.date | date: '%Y' }}</th>
            <td>
              {% if item.inline %}
                {% if include.compact and item.summary %}
                  {{ item.summary | markdownify | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% endif %}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{{ translations.no_news }}</p>
  {% endif %}
</div>
