<div class="col mb-4">
    <article class="card project-card h-100">
      <div class="row no-gutters">
        {% if project.img %}
          <div class="col-md-6">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
          </div>
        {% elsif project.visual %}
          <div class="col-md-6">
            <div class="project-visual project-visual-{{ project.visual }} h-100" aria-hidden="true">
              <span class="project-visual-icon"><i class="{{ project.visual_icon }}"></i></span>
              <span class="project-visual-copy">
                <small>{{ project.visual_kicker }}</small>
                <strong>{{ project.visual_label }}</strong>
              </span>
            </div>
          </div>
        {% endif %}
        <div class="{% if project.img or project.visual %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body d-flex flex-column h-100">
            <h3 class="card-title">
              <a class="project-card-title-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
                {{ project.title }}
              </a>
            </h3>
            <p class="card-text">{{ project.description }}</p>
            <div class="project-card-footer mt-auto">
              {% if project.technologies %}
                <div class="project-tech-stack" aria-label="Key technologies">
                  <span class="project-tech-label">Key technologies</span>
                  {% for technology in project.technologies %}
                    <span class="project-tech">{{ technology }}</span>
                  {% endfor %}
                </div>
              {% endif %}
              <div class="project-card-actions">
                <a class="project-card-action" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
                  View project <i class="fa-solid fa-arrow-right"></i>
                </a>
                {% if project.github %}
                  <div class="github-icon" data-toggle="tooltip" title="Code repository">
                    <a href="{{ project.github }}" target="_blank" rel="noopener" aria-label="Open code repository">
                      <i class="fa-brands fa-github gh-icon"></i>
                    </a>
                    {% if project.github_stars %}
                      <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                        <i class="fa-solid fa-star"></i>
                        <span id="{{ project.github_stars }}-stars"></span>
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
</div>
