{% assign current_lang = page.lang | default: site.lang %}
{% assign translations = site.data.i18n[current_lang] %}
<div class="col">
    <article class="card project-card h-100">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt=translations.project_thumbnail
          class="card-img-top"
        %}
      {% elsif project.visual %}
        <div class="project-visual project-visual-{{ project.visual }}" aria-hidden="true">
          <span class="project-visual-icon"><i class="{{ project.visual_icon }}"></i></span>
          <span class="project-visual-copy">
            <small>{{ project.visual_kicker }}</small>
            <strong>{{ project.visual_label }}</strong>
          </span>
        </div>
      {% endif %}
      <div class="card-body d-flex flex-column">
        <h2 class="card-title">
          <a class="project-card-title-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
            {{ project.title }}
          </a>
        </h2>
        <p class="card-text">{{ project.description }}</p>
        <div class="project-card-footer mt-auto">
          {% if project.technologies %}
            <div class="project-tech-stack" aria-label="{{ translations.key_technologies }}">
              <span class="project-tech-label">{{ translations.key_technologies }}</span>
              {% for technology in project.technologies %}
                <span class="project-tech">{{ technology }}</span>
              {% endfor %}
            </div>
          {% endif %}
          <div class="project-card-actions">
            <a class="project-card-action" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
              {{ translations.view_project }} <i class="fa-solid fa-arrow-right"></i>
            </a>
            {% if project.github %}
              <div class="github-icon" data-toggle="tooltip" title="{{ translations.code_repository }}">
                <a href="{{ project.github }}" target="_blank" rel="noopener" aria-label="{{ translations.open_code_repository }}">
                  <i class="fa-brands fa-github gh-icon"></i>
                </a>
                {% if project.github_stars %}
                  <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                    <i class="fa-solid fa-star"></i>
                    <span id="{{ project.github_stars }}-stars"></span>
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
</div>
