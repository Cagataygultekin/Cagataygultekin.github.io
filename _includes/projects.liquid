<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% elsif project.visual %}
        <div class="project-visual project-visual-{{ project.visual }}" aria-hidden="true">
          <span class="project-visual-icon"><i class="{{ project.visual_icon }}"></i></span>
          <span class="project-visual-copy">
            <small>{{ project.visual_kicker }}</small>
            <strong>{{ project.visual_label }}</strong>
          </span>
        </div>
      {% endif %}
      <div class="card-body d-flex flex-column">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        <div class="project-card-footer mt-auto">
          {% if project.technologies %}
            <div class="project-tech-stack" aria-label="Key technologies">
              <span class="project-tech-label">Technology profile</span>
              {% for technology in project.technologies %}
                <span class="project-tech">{{ technology }}</span>
              {% endfor %}
            </div>
          {% endif %}
          <div class="row ml-1 mr-1 p-0">
            {% if project.github %}
              <div class="github-icon">
                <div class="icon" data-toggle="tooltip" title="Code Repository">
                  <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                </div>
                {% if project.github_stars %}
                  <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                    <i class="fa-solid fa-star"></i>
                    <span id="{{ project.github_stars }}-stars"></span>
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
