---
layout: default
---
<div class="post">
  {% assign current_lang = page.lang | default: site.lang %}
  {% assign translations = site.data.i18n[current_lang] %}
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=translations.profile_photo
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {% if page.social %}
          <div class="profile-social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Selected projects -->
    {% if page.selected_projects %}
      <h2 class="mt-5 mb-3">
        <a href="{{ translations.routes.projects | relative_url }}" style="color: inherit">{{ translations.selected_projects }}</a>
      </h2>
      {% assign localized_projects = site.projects | where: 'lang', current_lang %}
      {% assign selected_projects = localized_projects | sort: 'importance' %}
      <div class="row row-cols-1 row-cols-md-2 home-selected-projects">
        {% for project in selected_projects limit: 4 %}
          {% include projects.liquid %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="mt-5 mb-3">
        <a href="{{ translations.routes.news | relative_url }}" style="color: inherit">{{ translations.news }}</a>
      </h2>
      {% include news.liquid compact=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">{{ translations.latest_posts }}</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="mt-5 mb-3">
        <a href="{{ translations.routes.academic_work | relative_url }}" style="color: inherit">{{ translations.selected_academic_work }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
